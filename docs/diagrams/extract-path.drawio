                <mxCell id="subtitle" value="Source of truth: src/DocInt.Api — Api/ExtractEndpoint · Validation/MultipartExtractRequestReader · Validation/FileKindDetector · Engines/{ExtractionService, EngineRouter, LayoutEngine, SpreadsheetEngine, VisionEngine}" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#666666" parent="1" vertex="1">
