        <mxCell id="caller" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="Calling service&lt;br&gt;&lt;i&gt;cluster-internal only, never via ingress&lt;/i&gt;" vertex="1">
