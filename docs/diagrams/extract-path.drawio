        <mxCell id="post" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;POST /v1/extract&lt;/b&gt;&lt;br&gt;multipart/form-data&lt;br&gt;N parts named &#39;files&#39; + optional &#39;hints&#39; part" vertex="1">
          <mxGeometry height="60" width="280" x="480" y="192" as="geometry" />
