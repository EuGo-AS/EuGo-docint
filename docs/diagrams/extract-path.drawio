                <mxCell id="title" value="EuGo-docint — POST /v1/extract call workflow, by file type" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontStyle=1" parent="1" vertex="1">
