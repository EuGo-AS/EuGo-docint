                <mxCell id="endpoint" value="ExtractEndpoint.Handle&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;Api/ExtractEndpoint.cs&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1">
