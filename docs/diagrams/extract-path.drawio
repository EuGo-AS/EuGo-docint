        <mxCell id="title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontStyle=1" value="Document Intelligence Service — POST /v1/extract call workflow, by file type" vertex="1">
