        </mxCell>
        <mxCell id="reader" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="MultipartExtractRequestReader.ReadAsync&lt;br&gt;&lt;i&gt;streams the body, buffers in memory — nothing touches disk&lt;/i&gt;" vertex="1">
          <mxGeometry height="60" width="280" x="480" y="366" as="geometry" />
        </mxCell>
        <mxCell id="d_wellformed" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="request itself&lt;br&gt;well-formed?" vertex="1">
          <mxGeometry height="80" width="240" x="500" y="462" as="geometry" />
        </mxCell>
        <mxCell id="e400" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" value="&lt;b&gt;400 Problem — &quot;Malformed extract request&quot;&lt;/b&gt;&lt;br&gt;&lt;br&gt;The &lt;u&gt;only&lt;/u&gt; non-200 outcome. Raised by BadExtractRequestException:&lt;br&gt;• not multipart/form-data, or boundary missing&lt;br&gt;• no part named &#39;files&#39;&lt;br&gt;• more than MaxFilesPerRequest (32) files&lt;br&gt;• declared body &gt; MaxRequestBytes (32 × 50 MiB + 1 MiB)&lt;br&gt;• &#39;hints&#39; part &gt; 256 KiB&lt;br&gt;• truncated / corrupt multipart framing" vertex="1">
          <mxGeometry height="160" width="400" x="980" y="420" as="geometry" />
        </mxCell>
        <mxCell id="band" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9673a6;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontColor=#6a4d8a;fontStyle=2" value="for each &#39;files&#39; part — still inside the reader" vertex="1">
          <mxGeometry height="250" width="900" x="40" y="600" as="geometry" />
        </mxCell>
        <mxCell id="buffer" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="buffer the part&lt;br&gt;&lt;i&gt;stop at MaxFileBytes (50 MiB) —&lt;br&gt;an oversized part is never fully buffered&lt;/i&gt;" vertex="1">
          <mxGeometry height="66" width="230" x="70" y="648" as="geometry" />
        </mxCell>
        <mxCell id="detect" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="&lt;b&gt;FileKindDetector.Detect&lt;/b&gt;&lt;br&gt;magic bytes → claimed content-type → extension" vertex="1">
          <mxGeometry height="66" width="250" x="360" y="648" as="geometry" />
        </mxCell>
        <mxCell id="fileitem" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;FileItem&lt;/b&gt; { Index, Name, Bytes,&lt;br&gt;Kind?, ImageMediaType?, Purpose?,&lt;br&gt;Warnings[], Error? }" vertex="1">
          <mxGeometry height="66" width="240" x="670" y="648" as="geometry" />
        </mxCell>
        <mxCell id="prevalid_err" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" value="&lt;b&gt;Error set here — no engine ever runs&lt;/b&gt;&lt;br&gt;too_large · empty_file · unsupported_type" vertex="1">
          <mxGeometry height="60" width="230" x="370" y="760" as="geometry" />
        </mxCell>
        <mxCell id="hints_note" parent="1" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" value="&lt;b&gt;&#39;hints&#39; part&lt;/b&gt; → HintsParser.Parse&lt;br&gt;{ &quot;bom.xlsx&quot;: { &quot;purpose&quot;: &quot;bom&quot; } }&lt;br&gt;&lt;br&gt;• known value (bom | photo) → FileItem.Purpose&lt;br&gt;• anything else → warning &quot;unknown purpose hint ... ignored&quot;&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#b85450&quot;&gt;Purpose is carried but read by nothing today&lt;/font&gt;&lt;/b&gt; —&lt;br&gt;routing is driven purely by the detected Kind." vertex="1">
          <mxGeometry height="150" width="400" x="980" y="620" as="geometry" />
        </mxCell>
        <mxCell id="legend" parent="1" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" value="&lt;b&gt;FileKindDetector — first match wins&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;%PDF&lt;/font&gt; → &lt;b&gt;pdf&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;89 50 4E 47 0D 0A 1A 0A&lt;/font&gt; → &lt;b&gt;image&lt;/b&gt; (png)&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;FF D8 FF&lt;/font&gt; → &lt;b&gt;image&lt;/b&gt; (jpeg)&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;PK&lt;/font&gt; (zip) → claimed type, else extension&lt;br&gt;    → &lt;b&gt;docx&lt;/b&gt; / &lt;b&gt;xlsx&lt;/b&gt; / &lt;b&gt;pptx&lt;/b&gt; — else null&lt;br&gt;text/html, .html/.htm, or &lt;font face=&quot;Courier New&quot;&gt;&amp;lt;!doctype&lt;/font&gt;/&lt;font face=&quot;Courier New&quot;&gt;&amp;lt;html&lt;/font&gt;&lt;br&gt;    → &lt;b&gt;html&lt;/b&gt;&lt;br&gt;otherwise → null → &lt;font color=&quot;#b85450&quot;&gt;unsupported_type&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;claimed type ≠ detected type adds a warning,&lt;br&gt;never an error — the bytes win.&lt;/i&gt;" vertex="1">
          <mxGeometry height="240" width="370" x="40" y="890" as="geometry" />
        </mxCell>
        <mxCell id="service" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;ExtractionService.ExtractAsync&lt;/b&gt;&lt;br&gt;Parallel.ForEachAsync&lt;br&gt;MaxDegreeOfParallelism = MaxParallelism (4)&lt;br&gt;&lt;i&gt;results are written by file.Index — request order is preserved&lt;/i&gt;" vertex="1">
          <mxGeometry height="80" width="300" x="530" y="900" as="geometry" />
        </mxCell>
        <mxCell id="perfile" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="per file: Activity &quot;docint.extract_file&quot;" vertex="1">
          <mxGeometry height="44" width="300" x="530" y="1016" as="geometry" />
        </mxCell>
        <mxCell id="telem_note" parent="1" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" value="&lt;b&gt;Telemetry, per file&lt;/b&gt;&lt;br&gt;• span tags: docint.kind, docint.size_bytes, docint.outcome&lt;br&gt;• metric pagesProcessed{kind}, only when &gt; 0&lt;br&gt;• one log line: name, kind, sizeBytes, outcome, durationMs&lt;br&gt;&lt;br&gt;&lt;b&gt;&lt;font color=&quot;#b85450&quot;&gt;Never document content&lt;/font&gt;&lt;/b&gt; — filenames and sizes only." vertex="1">
          <mxGeometry height="120" width="400" x="980" y="960" as="geometry" />
        </mxCell>
        <mxCell id="d_haserror" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="file.Error already set&lt;br&gt;by the reader?" vertex="1">
          <mxGeometry height="80" width="240" x="560" y="1100" as="geometry" />
        </mxCell>
        <mxCell id="router" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="&lt;b&gt;EngineRouter.RouteAsync&lt;/b&gt;&lt;br&gt;Dictionary&amp;lt;FileKind, IExtractionEngine&amp;gt;, built from engine.Kinds&lt;br&gt;linked CTS · CancelAfter(PerFileTimeoutSeconds = 100 s)" vertex="1">
          <mxGeometry height="80" width="340" x="510" y="1230" as="geometry" />
        </mxCell>
        <mxCell id="router_err" parent="1" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" value="&lt;b&gt;EngineRouter — per-file failure paths, every one a 200&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;before dispatch:&lt;/i&gt; no engine registered for the kind&lt;br&gt;  → &lt;b&gt;engine_error&lt;/b&gt; (early return, not an exception)&lt;br&gt;&lt;br&gt;&lt;i&gt;from the catch:&lt;/i&gt;&lt;br&gt;• our linked CTS fired → &lt;b&gt;timeout&lt;/b&gt;&lt;br&gt;• EngineUnconfiguredException → &lt;b&gt;engine_unconfigured&lt;/b&gt;&lt;br&gt;• any other exception → &lt;b&gt;engine_error&lt;/b&gt; (message only)&lt;br&gt;&lt;br&gt;&lt;b&gt;The one thing that is not caught:&lt;/b&gt; the &lt;i&gt;request&lt;/i&gt; token being&lt;br&gt;cancelled is rethrown — there is no client left to answer." vertex="1">
          <mxGeometry height="190" width="400" x="980" y="1140" as="geometry" />
        </mxCell>
        <mxCell id="layout_eng" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" value="&lt;b&gt;LayoutEngine&lt;/b&gt;&lt;br&gt;Kinds: pdf · docx · pptx · html&lt;br&gt;&lt;i&gt;four kinds, one engine, one call&lt;/i&gt;" vertex="1">
          <mxGeometry height="70" width="280" x="100" y="1390" as="geometry" />
        </mxCell>
        <mxCell id="sheet_eng" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;SpreadsheetEngine&lt;/b&gt;&lt;br&gt;Kinds: xlsx&lt;br&gt;&lt;i&gt;synchronous — Task.FromResult&lt;/i&gt;" vertex="1">
          <mxGeometry height="70" width="280" x="540" y="1390" as="geometry" />
        </mxCell>
        <mxCell id="vision_eng" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" value="&lt;b&gt;VisionEngine&lt;/b&gt;&lt;br&gt;Kinds: image (png / jpeg)&lt;br&gt;&lt;i&gt;factual observations only&lt;/i&gt;" vertex="1">
          <mxGeometry height="70" width="280" x="980" y="1390" as="geometry" />
        </mxCell>
        <mxCell id="di_client" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" value="AzureLayoutAnalysisClient.AnalyzeAsync&lt;br&gt;DocumentIntelligenceClient&lt;br&gt;model &quot;prebuilt-layout&quot;&lt;br&gt;OutputContentFormat.Markdown&lt;br&gt;WaitUntil.Completed &lt;i&gt;(long-running op)&lt;/i&gt;" vertex="1">
          <mxGeometry height="90" width="280" x="100" y="1500" as="geometry" />
        </mxCell>
        <mxCell id="openxml" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="OpenXML — SpreadsheetDocument.Open(MemoryStream)&lt;br&gt;typed cell values read straight from the stored XML,&lt;br&gt;never re-parsed display text&lt;br&gt;+ per-sheet Markdown rendering" vertex="1">
          <mxGeometry height="90" width="280" x="540" y="1500" as="geometry" />
        </mxCell>
        <mxCell id="aoai_client" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" value="AzureVisionChatClient.DescribeImageAsync&lt;br&gt;ChatClient.CompleteChatAsync&lt;br&gt;VisionPrompt.System + image content part&lt;br&gt;deployment Foundry:DeploymentNameVision" vertex="1">
          <mxGeometry height="90" width="280" x="980" y="1500" as="geometry" />
        </mxCell>
        <mxCell id="azure_di" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=#005A9E;fontColor=#ffffff;" value="&lt;b&gt;Azure AI Document Intelligence&lt;/b&gt;&lt;br&gt;EU region · private endpoint" vertex="1">
          <mxGeometry height="60" width="280" x="100" y="1630" as="geometry" />
        </mxCell>
        <mxCell id="no_net" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;dashed=1;" value="&lt;b&gt;no network call at all&lt;/b&gt;&lt;br&gt;&lt;i&gt;the Azure-free path — keeps working while both&lt;br&gt;Azure endpoints are unreachable&lt;/i&gt;" vertex="1">
          <mxGeometry height="60" width="280" x="540" y="1630" as="geometry" />
        </mxCell>
        <mxCell id="azure_aoai" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=#005A9E;fontColor=#ffffff;" value="&lt;b&gt;Azure OpenAI — Foundry utility model&lt;/b&gt;&lt;br&gt;EU region · private endpoint" vertex="1">
          <mxGeometry height="60" width="280" x="980" y="1630" as="geometry" />
        </mxCell>
        <mxCell id="tmp_note" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontColor=#666666" value="&lt;i&gt;OpenXML still spills package parts to /tmp even though the read is&lt;br&gt;from a MemoryStream — the chart&#39;s writable /tmp mount is load-bearing&lt;br&gt;under readOnlyRootFilesystem: true.&lt;/i&gt;" vertex="1">
          <mxGeometry height="46" width="360" x="500" y="1700" as="geometry" />
        </mxCell>
        <mxCell id="out_layout" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" value="&lt;b&gt;markdown&lt;/b&gt;&lt;br&gt;pagesProcessed = page count&lt;br&gt;+ service warnings" vertex="1">
          <mxGeometry height="66" width="280" x="100" y="1770" as="geometry" />
        </mxCell>
        <mxCell id="out_sheet" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" value="&lt;b&gt;tables[] (typed rows) + markdown&lt;/b&gt;&lt;br&gt;pagesProcessed = sheet count&lt;br&gt;&lt;i&gt;numeric fidelity is the point&lt;/i&gt;" vertex="1">
          <mxGeometry height="66" width="280" x="540" y="1770" as="geometry" />
        </mxCell>
        <mxCell id="out_vision" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" value="&lt;b&gt;imageDescription&lt;/b&gt;&lt;br&gt;pagesProcessed = 1" vertex="1">
          <mxGeometry height="66" width="280" x="980" y="1770" as="geometry" />
        </mxCell>
        <mxCell id="engine_err_note" parent="1" style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;" value="&lt;b&gt;Errors the engines return themselves&lt;/b&gt;&lt;br&gt;• &lt;b&gt;engine_unconfigured&lt;/b&gt; — !client.IsConfigured&lt;br&gt;  (Layout: Foundry:DocumentIntelligenceEndpoint unset;&lt;br&gt;   Vision: Foundry:OpenAIEndpoint unset)&lt;br&gt;• &lt;b&gt;corrupt&lt;/b&gt; — DI RequestFailedException 400,&lt;br&gt;  or an unreadable XLSX package&lt;br&gt;&lt;br&gt;&lt;i&gt;Both land in the file&#39;s own error entry.&lt;br&gt;SpreadsheetEngine additionally degrades a single&lt;br&gt;bad cell to a warning rather than failing the file.&lt;/i&gt;" vertex="1">
          <mxGeometry height="180" width="370" x="40" y="1880" as="geometry" />
        </mxCell>
        <mxCell id="result" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;results[file.Index] = FileResult&lt;/b&gt;&lt;br&gt;one entry per input file, in request order" vertex="1">
          <mxGeometry height="60" width="320" x="470" y="1900" as="geometry" />
        </mxCell>
        <mxCell id="resp200" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;200 OK&lt;/b&gt;&lt;br&gt;{ files: [ { name, kind, markdown?, tables?,&lt;br&gt;imageDescription?, warnings[], error? } ] }" vertex="1">
          <mxGeometry height="70" width="320" x="470" y="2010" as="geometry" />
        </mxCell>
        <mxCell id="constraint" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;spacingLeft=12;" value="&lt;b&gt;The load-bearing boundary:&lt;/b&gt; a well-formed request &lt;u&gt;always&lt;/u&gt; returns 200. Per-file failure is an &lt;font face=&quot;Courier New&quot;&gt;error&lt;/font&gt; entry beside the files that succeeded — one corrupt file never fails the call. Only a malformed &lt;i&gt;request&lt;/i&gt; yields 400." vertex="1">
          <mxGeometry height="70" width="530" x="850" y="2010" as="geometry" />
        </mxCell>
