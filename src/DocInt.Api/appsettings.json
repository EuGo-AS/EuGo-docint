{
  "DocInt": {
    "MaxFileBytes": 52428800,
    "MaxFilesPerRequest": 32,
    "PerFileTimeoutSeconds": 100,
    "MaxParallelism": 4
  },
  "AzureOpenAI": {
    "DeploymentNameVision": "gpt-5.4-mini"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Error",
        "System": "Error"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "Debug" }
    ]
  },
  "Kestrel": {
    "EndPoints": {
      "Http": {
        "Url": "http://*:8090"
      }
    }
  },
  "AllowedHosts": "*"
}
